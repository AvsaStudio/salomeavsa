# Server-only values. Never expose these with a VITE_ prefix.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
PORT=3001

# Local example: postgresql://postgres:postgres@localhost:5432/brewed_beans
DATABASE_URL=postgresql://username:password@localhost:5432/brewed_beans
# Use a separate disposable database for integration tests.
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/brewed_beans_test
# Set to true for hosted providers that require TLS.
DATABASE_SSL=false
